---
import SiteNav from './shared/SiteNav.astro';
import PlayfulHero from './heroes/PlayfulHero.astro';
import PromisesSection from './sections/PromisesSection.astro';
import HowItWorks from './sections/HowItWorks.astro';
import Subscription from './sections/Subscription.astro';
import Faq from './sections/Faq.astro';
import InstallOptions from './shared/InstallOptions.astro';
import AnimatedTranslationWindow from './shared/AnimatedTranslationWindow.astro';
import { getVariant, selectedVariantId } from '../data/variants';
import { release } from '../data/release';
import { routes, useMessages, type Locale } from '../i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'ko' } = Astro.props;
const t = useMessages(locale);
const otherLocale: Locale = locale === 'ko' ? 'en' : 'ko';
const variant = getVariant(selectedVariantId);
---

<div class="bg-accent">
  <SiteNav
    playful
    locale={locale}
    alternate={{ href: routes.home[otherLocale], locale: otherLocale }}
    links={[
      { href: '#how', label: t.nav.how },
      { href: '#subscription', label: t.nav.subscription },
      { href: '#faq', label: t.nav.faq },
    ]}
  />
</div>
<main id="main-content">
  <PlayfulHero variant={variant} production locale={locale} />
  <PromisesSection locale={locale} />
  <HowItWorks locale={locale} />
  <section id="app" class="border-t border-line bg-tint px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="font-mono text-xs text-muted">{t.app.eyebrow}</p>
        <h2 class="mt-5 font-playful text-3xl leading-[1.4] tracking-tight md:text-4xl">
          {t.app.title[0]}
          <br />
          {t.app.title[1]}
        </h2>
        <p class="mt-6 max-w-md text-sm leading-8 text-muted">{t.app.body}</p>
        <a
          href={routes.guide[locale]}
          class="mt-6 inline-flex min-h-11 items-center gap-3 font-semibold underline underline-offset-4"
        >
          {t.app.guideLink} <span aria-hidden="true">↗</span>
        </a>
      </div>
      <AnimatedTranslationWindow locale={locale} />
    </div>
  </section>
  <Subscription locale={locale} />
  <section id="install" class="scroll-mt-8 bg-accent px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <span class="inline-flex rounded-full border border-ink/20 px-3 py-1.5 font-mono text-[11px]">
          {t.install.badge(release.version)}
        </span>
        <h2 class="mt-6 font-playful text-4xl leading-[1.3] tracking-tight md:text-5xl">
          {t.install.title[0]}
          <br />
          {t.install.title[1]}
        </h2>
        <p class="mt-5 text-sm leading-8 text-muted">
          {t.install.requirement(release.minimumMacOS)}
          <br />
          {t.install.notarized}
        </p>
      </div>
      <div class="rounded-[28px] border-2 border-ink bg-page p-6 shadow-[5px_6px_0_#302a20] md:p-8">
        <InstallOptions locale={locale} />
      </div>
    </div>
  </section>
  <Faq tone="playful" locale={locale} />
</main>
<footer class="border-t border-line px-6 py-8">
  <div class="mx-auto flex max-w-6xl flex-col justify-between gap-6 text-xs leading-7 text-muted sm:flex-row sm:items-center">
    <a href="#top" class="text-base font-bold text-ink">
      deepK <span class="ml-2 text-xs font-normal text-muted">© 2026</span>
    </a>
    <nav aria-label={t.layout.footerNav} class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={routes.guide[locale]}>{t.footer.guide}</a>
      <a href={routes.privacy[locale]}>{t.footer.privacy}</a>
      <a href={release.notesUrl} target="_blank" rel="noopener noreferrer">
        {t.footer.notes}
      </a>
      <a href={`${release.repositoryUrl}/issues`} target="_blank" rel="noopener noreferrer">
        {t.footer.issues}
      </a>
    </nav>
  </div>
</footer>
