---
import type { Example } from '../../data/examples';
import { selectedVariantId } from '../../data/variants';
interface Props {
  example: Example;
  index: number;
}
const { example, index } = Astro.props;
const category = { design: '디자인', responsive: '반응형', flow: '체험 상태', guide: '안내' }[
  example.kind
];
---

<article
  data-example-card
  data-kind={example.kind}
  data-slug={example.slug}
  class="group overflow-hidden rounded-2xl border border-line bg-surface"
>
  <a
    href={`/examples/${example.slug}/`}
    data-open-case={example.slug}
    class="block"
    aria-label={`${example.title} 구현 화면 열기`}
  >
    <div class="relative h-52 overflow-hidden border-b border-line bg-[#ebe6dd]">
      <img
        src={`/thumbnails/${example.nodeId}.webp`}
        alt={`${example.title} 원본 디자인`}
        width="576"
        height="260"
        loading={index < 6 ? 'eager' : 'lazy'}
        class="h-full w-full object-cover object-top transition-transform duration-200 group-hover:scale-[1.025]"
      />
      <span class="absolute right-3 bottom-3 rounded-full bg-white/90 px-2.5 py-1 text-[9px] font-semibold text-[#776c5a]">
        원본 시안
      </span>
    </div>
    <div class="px-5 pt-5">
      <div class="flex items-center justify-between gap-3">
        <span class="font-mono text-[10px] text-muted">
          {String(index + 1).padStart(2, '0')} / {category}
        </span>
        <span class="text-base text-muted">↗</span>
      </div>
      <h2 class="mt-3 text-lg font-semibold tracking-tight">
        {example.title}{' '}
        {example.kind === 'design' && example.variant === selectedVariantId && (
          <span class="ml-2 rounded-full bg-accent px-2 py-1 text-[9px] font-medium text-[#2a2118]">
            현재 작업안
          </span>
        )}
      </h2>
      <p class="mt-2 min-h-10 text-xs leading-6 text-muted">{example.summary}</p>
    </div>
  </a>
  <div class="mx-5 mt-4 flex items-center justify-between gap-3 border-t border-line py-4">
    <span class="font-mono text-[10px] text-muted">{example.width}px</span>
    <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-medium">
      <input
        data-candidate={example.slug}
        aria-label={`${example.title} 후보 선택`}
        type="checkbox"
        class="h-4 w-4 accent-[#30281e]"
      />
      <span data-candidate-label>후보 선택</span>
    </label>
  </div>
</article>
