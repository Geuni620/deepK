---
import type { Variant } from '../../data/variants';
import HeroTitle from '../shared/HeroTitle.astro';
import PrimaryAction from '../shared/PrimaryAction.astro';
import { release } from '../../data/release';
import { useMessages, type Locale } from '../../i18n';
interface Props {
  variant: Variant;
  production?: boolean;
  locale?: Locale;
}
const { variant, production = false, locale = 'ko' } = Astro.props;
const t = useMessages(locale).hero;
const heroVariant = production
  ? { ...variant, headline: t.headline, description: t.description }
  : variant;
const [leftCard, rightCard] = t.cards;
---

<section class="bg-accent px-6 pt-12 pb-20 text-center">
  <HeroTitle variant={heroVariant} badge={t.badge} />
  <div class="mt-8">
    <PrimaryAction dark label={production ? t.cta : '⌘C ⌘C, 만나 보기'} locale={locale} />
    {production && (
      <p class="mt-4 text-xs leading-7 text-muted">
        {t.requirement(release.minimumMacOS, release.version)}
      </p>
    )}
  </div>
  <div class="relative mx-auto mt-14 flex max-w-4xl items-center justify-center gap-8">
    <div class="hidden max-w-58 -rotate-4 rounded-2xl border-2 border-ink bg-white p-5 text-left text-sm leading-6 shadow-[3px_4px_0_#302a20] lg:block">
      <p class="text-[11px] text-muted">{leftCard.source}</p>
      <p class="mt-2 font-bold">{leftCard.result}</p>
    </div>
    <img
      src="/brand/deepk-icon.png"
      alt={t.iconAlt}
      width="264"
      height="264"
      fetchpriority="high"
      class="w-52 rotate-3 rounded-[46px] border-2 border-ink shadow-[6px_7px_0_#302a20] md:w-66"
    />
    <div class="hidden max-w-58 rotate-3 rounded-2xl border-2 border-ink bg-white p-5 text-left text-sm leading-6 shadow-[3px_4px_0_#302a20] lg:block">
      <p class="text-[11px] text-muted">{rightCard.source}</p>
      <p class="mt-2 font-bold">{rightCard.result}</p>
    </div>
  </div>
</section>
