---
import type { Variant } from '../../data/variants';
import HeroTitle from '../shared/HeroTitle.astro';
import PrimaryAction from '../shared/PrimaryAction.astro';
import TranslationWindow from '../shared/TranslationWindow.astro';
interface Props {
  variant: Variant;
}
const { variant } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 pt-14 pb-20 md:pt-20 lg:px-12">
  <HeroTitle variant={variant} />
  <div class="my-9 flex flex-wrap items-center justify-center gap-4">
    <PrimaryAction />
    <span class="text-xs text-muted">macOS 15 이상 · 구독 계정 사용</span>
  </div>
  <div class="mt-14 grid min-h-96 items-center justify-items-center gap-10 rounded-[28px] bg-tint p-7 md:grid-cols-[.7fr_1.3fr] md:p-16">
    <div class="text-center">
      <img
        src="/brand/deepk-icon.png"
        alt="deepK 곰 아이콘"
        width="200"
        height="200"
        class="mx-auto w-36 rounded-[30px] shadow-2xl md:w-52"
      />
      <div class="mt-6 flex justify-center gap-2">
        <kbd class="rounded-lg bg-white px-3 py-2 font-mono text-sm text-[#2a2118]">⌘ C</kbd>
        <kbd class="rounded-lg bg-white px-3 py-2 font-mono text-sm text-[#2a2118]">⌘ C</kbd>
      </div>
    </div>
    <TranslationWindow />
  </div>
</section>
