---
import SiteNav from '../shared/SiteNav.astro';
import { examples } from '../../data/examples';
const flows = examples.filter((example) => example.kind === 'flow');
---

<SiteNav links={[{ href: '#flow', label: '체험 흐름' }]} />
<main id="flow" class="mx-auto max-w-6xl px-6 pt-14 pb-24">
  <p class="font-mono text-xs text-muted">WEB DEMO / FOUR STATES</p>
  <h1 class="mt-7 text-4xl leading-[1.3] font-bold tracking-[-.05em] md:text-6xl">
    하나의 체험,
    <br />네 가지 순간.
  </h1>
  <p class="mt-6 max-w-2xl text-sm leading-8 text-muted">
    문서를 읽고 문단을 고른 뒤 작은 번역 창을 확인합니다. 직접 입력으로 옮겨갈 수도 있습니다. 각
    카드를 열면 해당 상태부터 직접 확인할 수 있습니다.
  </p>
  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {flows.map((example, index) => (
      <a
        target="_top"
        href={`/?case=${example.slug}`}
        class="group overflow-hidden rounded-3xl border border-line bg-surface"
      >
        <div class="flex items-center justify-between p-6">
          <span class="font-mono text-sm text-muted">0{index + 1}</span>
          <span class="text-xl group-hover:translate-x-1">↗</span>
        </div>
        <div class="mx-6 h-44 overflow-hidden rounded-xl bg-page">
          <img
            src={`/thumbnails/${example.nodeId}.webp`}
            alt=""
            class="h-full w-full object-cover object-top"
          />
        </div>
        <h2 class="px-6 pt-6 text-xl font-semibold">{example.title}</h2>
        <p class="px-6 pt-3 pb-7 text-sm leading-7 text-muted">{example.summary}</p>
      </a>
    ))}
  </div>
</main>
