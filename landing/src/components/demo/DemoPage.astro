---
import SiteNav from '../shared/SiteNav.astro';
import TranslationDemo from './TranslationDemo.astro';
import type { DemoState } from '../../data/samples';
interface Props {
  initialState: DemoState;
}
const { initialState } = Astro.props;
const descriptions = {
  intro: [
    '01 · 첫 방문',
    '준비된 문서로 바로 시작합니다. 예시를 바꾸거나 직접 입력할 수 있습니다.',
  ],
  selected: ['02 · 문단 선택', '문단을 고르면 필요한 부분의 번역을 확인할 수 있습니다.'],
  result: ['03 · 번역 결과', '작은 결과 창을 읽고 닫은 뒤 원문을 이어 읽습니다.'],
  input: [
    '04 · 직접 입력',
    '예시 문장을 편집하며 입력 상태를 확인합니다. 새 문장의 실제 번역은 API 연결 후 지원합니다.',
  ],
};
const [title, description] = descriptions[initialState];
---

<SiteNav />
<main id="demo" class="mx-auto max-w-6xl px-6 pt-12 pb-24">
  <p class="text-center font-mono text-xs text-muted">WEB DEMO · {title}</p>
  <h1 class="mx-auto mt-6 max-w-4xl text-center text-4xl leading-[1.3] font-bold tracking-[-.05em] md:text-6xl">
    읽던 자리에서,
    <br class="md:hidden" /> 그대로 이해하세요.
  </h1>
  <p class="mx-auto mt-5 max-w-2xl text-center text-sm leading-8 text-muted">{description}</p>
  <div class="mt-10">
    <TranslationDemo initialState={initialState} />
  </div>
  <nav aria-label="체험 상태 이동" class="mt-7 flex flex-wrap justify-center gap-2 text-xs">
    {[
      ['demo-start', '첫 방문'],
      ['demo-selected', '문단 선택'],
      ['demo-result', '번역 결과'],
      ['demo-input', '직접 입력'],
    ].map(([slug, label]) => (
      <a
        target="_top"
        href={`/?case=${slug}`}
        class="rounded-full border border-line bg-surface px-4 py-2 hover:bg-tint"
      >
        {label}
      </a>
    ))}
  </nav>
  <p class="mt-6 text-center text-xs leading-7 text-muted">
    설명용 예시입니다. 실제 모델 요청·과금·분석 이벤트 전송은 실행하지 않습니다.
  </p>
</main>
