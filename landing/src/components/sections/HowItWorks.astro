---
import { useMessages, type Locale } from '../../i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'ko' } = Astro.props;
const t = useMessages(locale).how;
const steps = t.steps;
---

<section id="how" class="border-t border-line px-6 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <p class="font-mono text-xs text-muted">{t.eyebrow}</p>
    <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-.045em] md:text-5xl">{t.title}</h2>
    <div class="mt-14 grid gap-10 md:grid-cols-3">
      {steps.map((step) => (
        <article class="border-t border-line pt-5">
          <span class="font-mono text-xs text-muted">{step.n}</span>
          <h3 class="mt-5 text-xl font-semibold">{step.title}</h3>
          <p class="mt-3 text-sm leading-7 text-muted">{step.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>
