---
import { useMessages, type Locale } from '../../i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'ko' } = Astro.props;
const t = useMessages(locale).subscription;
---

<section id="subscription" class="bg-inverse px-6 py-20 text-[#fffaf0] md:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
    <div>
      <p class="font-mono text-xs text-[#b5a994]">{t.eyebrow}</p>
      <h2 class="mt-6 text-3xl leading-[1.35] font-bold tracking-tight md:text-5xl">
        {t.title[0]}
        <br />
        {t.title[1]}
      </h2>
      <p class="mt-6 max-w-md text-sm leading-8 text-[#c7bdab]">{t.body}</p>
    </div>
    <div class="space-y-4 rounded-2xl border border-white/10 bg-white/5 p-6">
      {['ChatGPT · Codex CLI', 'Claude · Claude Code'].map((name) => (
        <div class="flex items-center justify-between border-b border-white/10 py-5 last:border-0">
          <span class="text-base font-medium">{name}</span>
          <span class="text-xs text-[#c8bb9c]">{t.login}</span>
        </div>
      ))}
      <p class="pt-2 text-xs leading-6 text-[#a99e89]">{t.note}</p>
    </div>
  </div>
</section>
