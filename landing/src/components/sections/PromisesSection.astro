---
import { useMessages, type Locale } from '../../i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'ko' } = Astro.props;
const t = useMessages(locale).promises;
---

<section id="privacy" class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <h2 class="text-center font-playful text-3xl md:text-4xl">{t.title}</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {t.items.map(([mark, title, copy], index) => (
        <article
          class:list={[
            'rounded-[28px] border-2 border-ink p-8 shadow-[4px_5px_0_#302a20]',
            ['bg-[#fff4bd]', 'bg-[#e6f2ff]', 'bg-[#e7f5e9]'][index],
          ]}
        >
          <span class="text-4xl">{mark}</span>
          <h3 class="mt-7 font-playful text-xl">{title}</h3>
          <p class="mt-4 text-sm leading-8 text-muted">{copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>
