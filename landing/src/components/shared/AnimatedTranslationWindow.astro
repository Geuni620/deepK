---
import { useMessages, type Locale } from '../../i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'ko' } = Astro.props;
const t = useMessages(locale).app;
const [first] = t.samples;
---

<figure>
  <div
    data-translation-window
    data-samples={JSON.stringify(t.samples)}
    data-translating={t.window.translating}
    data-copy={t.window.copy}
    data-copied={t.window.copied}
    role="img"
    aria-label={t.window.label}
    class="overflow-hidden rounded-[24px] border-2 border-ink bg-white text-[#2a2118] shadow-[5px_6px_0_#302a20]"
  >
    <div class="flex items-center gap-2 border-b border-[#ece7df] px-5 py-3.5">
      <span class="h-3 w-3 rounded-full bg-[#ff6258]"></span>
      <span class="h-3 w-3 rounded-full bg-[#ffc400]"></span>
      <span class="h-3 w-3 rounded-full bg-[#dcd8d2]"></span>
      <span class="ml-3 text-sm font-bold text-[#6b6257]">deepK</span>
    </div>
    <div class="px-6 pt-5 md:px-8">
      <div class="flex items-center justify-between gap-4 text-xs text-[#4d4439] md:text-sm">
        <span>{t.window.direction}</span>
        <span class="flex items-center gap-3 text-[#8a8177]">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none">
            <path
              d="m5 5 10 10M15 5 5 15"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            ></path>
          </svg>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
            <path
              d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
      </div>
      <div class="tw-slot mt-4 pb-6 text-base leading-8 text-[#8f867b] md:text-lg">
        {t.samples.map((sample) => (
          <p class="tw-ghost">{sample.source}</p>
        ))}
        <p class="tw-live tw-fade" data-window-part="source">
          <span data-live-source>{first.source}</span>
          <span class="tw-caret" data-caret></span>
        </p>
      </div>
      <div class="h-px bg-[#ece7df]"></div>
      <div class="tw-slot min-h-36 pt-6 pb-8 text-xl leading-9 font-semibold md:min-h-44 md:text-2xl md:leading-10">
        {t.samples.map((sample) => (
          <p class="tw-ghost">{sample.result}</p>
        ))}
        <p class="tw-live tw-fade" data-window-part="result" data-live-result>
          {first.result}
        </p>
      </div>
    </div>
    <div class="flex items-center justify-between gap-4 border-t border-[#ece7df] px-6 py-3.5 md:px-8">
      <span data-live-status class="tw-status text-xs text-[#8f867b] md:text-sm"></span>
      <span
        data-live-copy
        class="rounded-lg bg-[#f1eee9] px-4 py-2 text-sm font-semibold text-[#2a2118] transition-colors duration-200"
      >
        {t.window.copy}
      </span>
    </div>
  </div>
  <figcaption class="mt-5 text-center text-xs leading-6 text-muted">{t.caption}</figcaption>
</figure>

<style>
  .tw-slot {
    display: grid;
  }
  .tw-slot > * {
    grid-area: 1 / 1;
  }
  .tw-ghost {
    visibility: hidden;
  }
  .tw-fade {
    transition:
      opacity 240ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 240ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .tw-fade[data-hidden] {
    opacity: 0;
    transform: translateY(6px);
  }
  .tw-caret {
    display: none;
    width: 2px;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: #2f7bf6;
  }
  [data-animating] .tw-caret {
    display: inline-block;
    animation: tw-blink 1.06s steps(1) infinite;
  }
  [data-typing] .tw-caret {
    animation: none;
  }
  .tw-status:not(:empty) {
    animation: tw-pulse 1.2s ease-in-out infinite;
  }
  @keyframes tw-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes tw-pulse {
    50% {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tw-fade,
    .tw-status:not(:empty) {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { mountTranslationWindow } from '../../scripts/translation-window';
  document
    .querySelectorAll<HTMLElement>('[data-translation-window]')
    .forEach(mountTranslationWindow);
</script>
