---
import { release } from '../../data/release';

interface Props {
  guideLink?: boolean;
}
const { guideLink = true } = Astro.props;
---

<div data-install-options>
  <p class="text-sm font-semibold">Homebrew로 설치</p>
  <div class="mt-3 flex items-center gap-2 rounded-xl border border-line/20 bg-tint p-3">
    <code class="min-w-0 flex-1 break-all font-mono text-[11px] leading-6 sm:text-xs">
      {release.installCommand}
    </code>
    <button
      type="button"
      data-copy-install={release.installCommand}
      aria-label="Homebrew 설치 명령 복사"
      class="min-h-11 shrink-0 rounded-lg bg-ink px-3 text-xs font-semibold text-page"
    >
      <span data-copy-label>복사</span>
    </button>
  </div>
  <p data-install-copy-status role="status" class="mt-2 min-h-5 text-xs leading-5 text-muted"></p>
  <div class="my-3 flex items-center gap-4 text-[11px] text-muted">
    <span class="h-px flex-1 bg-line/15"></span>또는<span class="h-px flex-1 bg-line/15"></span>
  </div>
  <a
    href={release.downloadUrl}
    class="flex min-h-12 items-center justify-center gap-3 rounded-full border-2 border-ink px-5 py-3 text-sm font-semibold"
  >
    <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true">
      <path
        d="M10 3v10m-4-4 4 4 4-4M4 14v3h12v-3"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    Mac 앱 ZIP 다운로드
  </a>
  <p class="mt-5 text-xs leading-7 text-muted">
    Apple Silicon · macOS {release.minimumMacOS} 이상
    <br />
    번역용 Codex CLI 또는 Claude Code의 설치·구독 로그인이 필요해요.
  </p>
  {guideLink && (
    <a
      href="/guide/"
      class="mt-4 inline-flex min-h-11 items-center text-xs font-semibold underline underline-offset-4"
    >
      CLI 로그인과 권한 설정이 처음이라면 ↗
    </a>
  )}
</div>
