---
import InstallOptions from './InstallOptions.astro';
import { release } from '../../data/release';
import { useMessages, type Locale } from '../../i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'ko' } = Astro.props;
const t = useMessages(locale).installDialog;
---

<dialog
  id="install-info"
  aria-labelledby="install-heading"
  class="fixed inset-0 m-auto max-h-[90dvh] w-[min(520px,calc(100%_-_32px))] overflow-y-auto rounded-3xl border-2 border-line bg-page p-6 text-ink shadow-2xl sm:p-8"
>
  <div class="mb-6 flex items-center justify-between gap-4">
    <span class="text-xs font-semibold tracking-wide text-muted">{t.badge(release.version)}</span>
    <button
      type="button"
      data-close-install
      aria-label={t.close}
      class="min-h-11 min-w-11 rounded-full text-xl"
    >
      ×
    </button>
  </div>
  <h2 id="install-heading" class="text-2xl font-bold tracking-tight">
    {t.title}
  </h2>
  <p class="mt-3 mb-7 text-sm leading-7 text-muted">{t.body}</p>
  <InstallOptions locale={locale} />
</dialog>
