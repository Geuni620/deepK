---
import InstallOptions from './InstallOptions.astro';
import { release } from '../../data/release';
---

<dialog
  id="install-info"
  aria-labelledby="install-heading"
  class="fixed inset-0 m-auto max-h-[90dvh] w-[min(520px,calc(100%_-_32px))] overflow-y-auto rounded-3xl border-2 border-line bg-page p-6 text-ink shadow-2xl sm:p-8"
>
  <div class="mb-6 flex items-center justify-between gap-4">
    <span class="text-xs font-semibold tracking-wide text-muted">
      deepK {release.version} · 초기 배포
    </span>
    <button
      type="button"
      data-close-install
      aria-label="설치 안내 닫기"
      class="min-h-11 min-w-11 rounded-full text-xl"
    >
      ×
    </button>
  </div>
  <h2 id="install-heading" class="text-2xl font-bold tracking-tight">
    Mac에 deepK 설치하기
  </h2>
  <p class="mt-3 mb-7 text-sm leading-7 text-muted">
    편한 방법으로 설치하고, 쓰던 AI 계정을 연결하세요.
  </p>
  <InstallOptions />
</dialog>
