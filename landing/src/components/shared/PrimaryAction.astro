---
interface Props {
  label?: string;
  dark?: boolean;
}
const { label = 'Mac용 설치 안내', dark = false } = Astro.props;
---

<a
  href="/guide/#install"
  data-install-info
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 text-sm font-semibold transition-colors',
    dark ? 'bg-ink text-page hover:opacity-85' : 'bg-accent text-[#2a2118] hover:brightness-95',
  ]}
>
  <span aria-hidden="true">↓</span>
  {label}
</a>
