---
import { useMessages, type Locale } from '../../i18n';
interface Props {
  compact?: boolean;
  locale?: Locale;
}
const { compact = false, locale = 'ko' } = Astro.props;
const t = useMessages(locale).nav;
---

<a
  href="#top"
  class="inline-flex shrink-0 items-center gap-2.5 font-bold tracking-tight"
  aria-label={t.brand}
>
  <img
    src="/brand/deepk-icon.png"
    alt=""
    width={compact ? 26 : 34}
    height={compact ? 26 : 34}
    class="rounded-[9px]"
  />
  <span class:list={[compact ? 'text-base' : 'text-xl']}>deepK</span>
</a>
