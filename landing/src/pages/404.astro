---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="화면을 찾을 수 없습니다">
  <main class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="font-mono text-xs text-muted">404</p>
    <h1 class="mt-6 text-4xl font-bold tracking-tight">화면을 찾을 수 없어요.</h1>
    <a
      href="/"
      class="mt-9 inline-block rounded-full bg-ink px-6 py-3 text-sm font-semibold text-page"
    >
      deepK 처음으로 →
    </a>
  </main>
</PageLayout>
