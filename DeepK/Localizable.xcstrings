    },
    "원문이 기본 대상과 같으면 영어로 번역합니다. 영어끼리는 대상을 선택하세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문이 기본 대상과 같으면 영어로 번역합니다. 영어끼리는 대상을 선택하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the source matches the default target, translate to English. For English, choose another target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文が既定の翻訳先と同じなら英語に翻訳します。英語同士の場合は別の翻訳先を選んでください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原文與預設目標相同時會翻譯成英文。若皆為英文，請選擇其他目標。"
          }
        }
      }
    },
